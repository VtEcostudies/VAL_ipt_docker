# Backup artifacts never belong in git -- they are multi-GB and live in
# /usr/local/backups on the host. 08_install_backups.sh moves any that were
# left in aws_backups/ out to the host's data directory.
*.tar.gz
*.tar.gz.partial
backup_status.tsv
legacy_review/

# Certs and keys
*.pem
*.key
*.crt

# SES / SMTP credentials. The console hands you a CSV holding a live SMTP
# password in cleartext; it tends to land in whatever directory you were in.
# This repo is public -- never let one become committable.
*credentials*.csv
*_credentials.csv
sasl_passwd
sasl_passwd.db
